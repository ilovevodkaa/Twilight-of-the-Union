# Twilight of the Union: loading screen sprites (replaces the vanilla file of the same name).
# hoi4.exe reads this file, load_screen.gui and load_screen_font.gfx before every other interface file, so every
# sprite of the loading screen is declared here, even the ones that share a texture with the main menu.
# TotU textures are generated by tools/build_menu_gfx.py (LOAD_* constants); edit the script, not the DDS.
spriteTypes = {

	 spriteType = {
	 	name = "GFX_nullobject"
	 	texturefile = "gfx//interface//thisisdog.dds"
	 }

	spriteType = {
		name = "GFX_frontend_dev_logo_s"
		texturefile = "gfx/interface/pdx_dev_logo_s.dds"
	}

	spriteType = {
		name = "GFX_pdx_int_logo"
		texturefile = "gfx/interface/pdx_int_logo.dds"
	}

	spriteType = {
		name = "GFX_clausewitz_logo"
		texturefile = "gfx/interface/clausewitz_logo.dds"
	}

	# TotU: the menu's title scrim, under the logo (UPPER_LEFT)
	spriteType = {
		name = "GFX_totu_load_scrim_title"
		texturefile = "gfx/interface/totu/scrim_title.dds"
	}

	# TotU: lower-third scrim under the subtitle, name strap, status and bar (LOWER_LEFT), 1600x760, alpha 58 %
	spriteType = {
		name = "GFX_totu_load_scrim_caption"
		texturefile = "gfx/interface/totu/scrim_caption.dds"
	}

	# TotU: the vanilla tip and status boxes, now transparent (the engine looks the icons up by name)
	spriteType = {
		name = "GFX_loadingtip_bg"
		texturefile = "gfx/interface/totu/loading_blank.dds"
	}

	spriteType = {
		name = "GFX_loadingstatus_bg"
		texturefile = "gfx/interface/totu/loading_blank.dds"
	}

	# TotU: game logo, same texture as the main menu (542x322, 36 px glow pad)
	spriteType = {
		name = "GFX_totu_loading_logo"
		texturefile = "gfx/interface/totu/menu_logo.dds"
	}

	# TotU: 576x6 keyer-blue bar on a faint track. progress.lua shows textureFile1 left of the progress and
	# textureFile2 right of it with unchanged UVs, so neither texture is stretched.
	progressbartype = {
		name = "GFX_loadingstatus_progress"
		color = { 0.0 0.5 0.0 }
		colortwo = { 1.0 0.0 0.0 }
		textureFile1 = "gfx/interface/totu/loading_progress_full.dds"
		textureFile2 = "gfx/interface/totu/loading_progress_empty.dds"
		size = { x = 576 y = 6 }
		effectFile = "gfx//FX//progress.lua"
		horizontal = yes
		steps = 1000000
	}
}

guiTypes = {

	containerWindowType = {
		name ="proxy_window"
		position = { x=0 y =0}
		size = { width=1 height =1}
	}

	### bookmark entry
	# TotU: the inset still of the scenario picker, 512x288 (SCEN_PIC in tools/build_menu_gfx.py). The background
	# (GFX_bookmark_entry_bg) is fully transparent in both frames: the engine needs it to click the entry, but
	# nothing marks a selection and clicking makes no sound. The engine swaps the icon for the bookmark's picture
	# (GFX_select_date_1990). The date is off-screen: the menu's title block already shows it.
	containerWindowType = {
		name = "bookmark_entry"
		position = { x= 0 y = 0 }
		size = { width = 512 height = 288 }
		clipping = no
		fade_time = 500
		fade_type = linear

		background = {
			name = "background"
			quadTextureSprite = "GFX_bookmark_entry_bg"
		}

		iconType = {
			name = "icon"
			spriteType = "GFX_select_date_1936"
			position = { x = 0 y = 0 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "date"
			position = { x = -9000 y = -9000 }
			font = "hoi_20b"
			borderSize = {x = 0 y = 0}
			text = "FE_BOOKMARK_DATE"
			maxWidth = 300
			maxHeight = 30
			format = left
		}
	}

	containerWindowType = {
		name = "spirit_idea_entry"
		size = { width=60 height=68 }
		clipping = no

		iconType = {
			name = "icon"
			quadTextureSprite ="GFX_idea_unknown"
			orientation = "CENTER"
			centerPosition = yes
		}
	}

	containerWindowType = {
		name = "spirit_idea_entry_small"
		size = { width=33 height=37 }
		clipping = no

		iconType = {
			name = "icon"
			quadTextureSprite ="GFX_idea_unknown"
			orientation = "CENTER"
			centerposition = yes
			scale = 0.55
		}
	}

	containerWindowType = {
		name = "spirit_modifier_entry"
		size = { width=60 height=68 }
		clipping = no

		iconType = {
			name = "icon"
			quadTextureSprite ="GFX_idea_unknown"
			orientation = "CENTER"
			centerPosition = yes
		}

		iconType = {
			name = "flag"
			position = { x = 2 y = 37 }
			quadTextureSprite ="GFX_flag_small"
			orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
	}

	containerWindowType = {
		name = "spirit_modifier_entry_small"
		size = { width=33 height=37 }
		clipping = no

		iconType = {
			name = "icon"
			quadTextureSprite ="GFX_idea_unknown"
			orientation = "CENTER"
			centerPosition = yes
			scale = 0.55
		}

		iconType = {
			name = "flag"
			position = { x = 18 y = 35 }
			quadTextureSprite ="GFX_mapicon_unit_flag_stripe"
			orientation = "UPPER_LEFT"
		}
	}

	containerWindowType = {
		name = "focus_entry"
		size = { width=60 height=80}
		clipping = no

		iconType = {
			name = "icon"
			quadTextureSprite ="GFX_idea_unknown"
			orientation = "CENTER"
			centerPosition = yes
		}
	}

	### country entry
	# TotU: major card, 220x274 (MAJOR_* in tools/build_menu_gfx.py): the flag centred on x 110, the selection bar
	# under it (frame 2 of GFX_country_selection_entry; frame 1 is transparent), the name as a dim caption under the
	# bar, centred and hanging from the same line whether it takes 1, 2 or 3 lines.
	containerWindowType = {
		name = "country_entry"

		buttonType = {
			name = "country_leader"
			quadTextureSprite ="GFX_leader_unknown"
			position = { x = -9000 y = -9000 } # TotU: flag-only cards
			scale=0.75
			clicksound = click_checkbox
		}

		iconType = {
			name = "country_flag"
			quadTextureSprite ="GFX_shield_medium"
			position = { x = 69 y = 104 } # TotU: MAJOR_FLAG_POS (scale is ignored by the engine)
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}

		buttonType = {
			name = "country"
			quadTextureSprite = "GFX_country_selection_entry"
			position = { x=0 y =0 }
			clicksound = click_checkbox
			oversound = ui_menu_over
		}

		iconType = {
			name = "new_content"
			position = { x = -9000 y = -9000 } # TotU: no unplayed-content dot
			spriteType = "GFX_unplayed_content_notification"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "country_name"
			position = { x = 12 y = 180 } # TotU: MAJOR_NAME, 16 px under the bar
			font = "totu_caption_name" # TotU: engine-filled; vanilla CJK font in Japanese / Chinese / Korean
			text_color_code = D
			borderSize = {x = 0 y = 0}
			maxWidth = 196
			maxHeight = 56 # TotU: up to three lines of 18
			fixedsize = yes
			format = center
			vertical_alignment = top
			Orientation = "UPPER_LEFT"
		}
	}


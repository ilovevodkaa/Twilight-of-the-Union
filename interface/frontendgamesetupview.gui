	### COUNTRY SELECTION (TotU "broadcast"; design tools/preview/screen_country.png from tools/preview_country.py,
	# layout CS_* / MAJOR_* / MINOR_* in tools/build_menu_gfx.py). Window px at UI scale 1.0; the window is 1225x717,
	# centred and moveable as in vanilla.
	#   - A soft scrim around the window dims the map; the board (GFX_country_selection_bg) is one opaque near-black
	#     plate at 14,41..1211,712 with the USA / USSR banners full-bleed in its top band. No frames, no panels.
	#   - The title is a caption inside the board, centred on its axis (x 612) in the dark gap between the banners,
	#     above the major flags (capitals y 79..107; black K copy at +2,+2, as on the main menu). Nothing hangs outside
	#     the board, so at 1366x768 the window's top edge no longer meets the lobby's top captions.
	#   - Majors: two 220 px cards centred on the board axis (x 612); minors: 8 flags on the text measure 36..1189.
	#     The selected country gets an 8 px keyer bar under its flag (frame 2 of the entry sprites).
	#   - Lower block, first caption line at y 456: info (x 36, dim caption labels over hoi_20b values every 44 px),
	#     centre (x 434: nation_title, the national spirits, Select / Back), history (x 834). 44 px gutters.
	#   - Select / Back: the main menu's caption plates, 64 px apart (PLATE_PITCH 44 + QUIT_GAP 20); labels are
	#     left-aligned caption boxes 22 px in, 6 px down, with the K copy.
	# Every element the engine looks up by name stays; the unused ones are off-screen.
	containerWindowType = {
		name ="gamesetup_interesting_countries_window"
		size = { width=1225 height=717 }

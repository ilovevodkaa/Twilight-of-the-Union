	# "Updating history" (TotU "broadcast"): no panel. The loading screen's status line, in the same place (x 192,
	# capitals H-104..H-90) on the same lower-third scrim, so the cut to the loading screen keeps it where it is.
	containerWindowType = {
		name ="loading_history"
		position = { x=0 y =0}
		size = { width=100% height =100%}
		clipping = no

		iconType = {
			name = "totu_history_scrim"
			spriteType = "GFX_totu_load_scrim_caption"
			Orientation = LOWER_LEFT
			position = { x = -120 y = -576 }
			alwaystransparent = yes
		}

		containerWindowType = {
			name ="pane"
			position = { x=192 y =-104}
			size = { width=1056 height =18 }
			clipping = no
			orientation = LOWER_LEFT

			instantTextBoxType = {
				name = "label"
				position = { x = 0 y = 0 }
				font = "totu_caption_name"
				text_color_code = P
				borderSize = {x = 0 y = 0}
				text = "FE_LOADING_HISTORY"
				maxWidth = 1056
				maxHeight = 18
				fixedsize = yes
				vertical_alignment = top
				format = left
			}
		}
	}

	### LOBBY FRAME (TotU "broadcast"; layout in tools/build_menu_gfx.py, "Lobby frame"). Screen px at UI scale 1.0.
	# The map is the picture. Top and bottom carry a soft black band (GFX_totu_band_*, 160 px, alpha 62 % at the edge
	# fading to 0, click-through), no bar, no rivets, no rules:
	#   top left (x 192): Notable countries, Random country (Observer in multiplayer) as small caption buttons;
	#   top centre: the date (P) over the scenario name (D), engine-filled, in totu_caption_name;
	#   top right (W - 192): the selected country's flag, its name right-aligned beside it, the Details toggle under it.
	#   bottom: Back, Load, Options on the menu's last row (plates from x 170, H - 112); Start / Ready right-aligned to
	#   W - 192 on the same row, the ready checkbox before it.
	# Button text is the engine's (buttonText in totu_button*, K edge baked in): the engine hides some of these buttons.
	# Every element the engine looks up by name stays; the unused ones are off-screen.
	containerWindowType = {
		name ="frontendgamesetupview"
		position = { x=0 y =0}
		size = { width=100% height =100%}
		clipping = no

		containerWindowType = {
			name ="top"
			position = { x=0 y = -160}
			show_position = { x=0 y =0}
			animation_type = decelerated
			animation_time = 1000
			size = { width=100% height =160}
			clipping = no

			containerWindowType = {
				name = background
				size = { width=100% height=100% }
				Background =
				{
					name ="top_bg"
					spriteType = "GFX_totu_band_top"
					alwaystransparent = yes
				}
			}

			containerWindowType = {
				name ="scenario_window"
				position = { x=50% y = 0}
				show_position = { x=50% y = 0}
				animation_type = decelerated
				animation_time = 1000
				size = { width=360 height =128}
				clipping = no

				iconType ={
					name ="menu_top_date_bg"
					spriteType = "GFX_menu_top_bg_bg"
					position = { x= -9000 y = -9000 } # TotU: no plate
				}

				# capitals y 35..49, centred on the screen axis
				instantTextBoxType = {
					name = "date"
					position = { x = -180 y = 35 }
					font = "totu_caption_name"
					text_color_code = P
					borderSize = {x = 0 y = 0}
					text = "Pikku Saippuakauppias Itkee!!"
					maxWidth = 360
					maxHeight = 18
					fixedsize = yes
					format = centre
				}

				# capitals y 63..77
				instantTextBoxType = {
					name = "name"
					position = { x = -180 y = 63 }
					font = "totu_caption_name"
					text_color_code = D
					borderSize = {x = 0 y = 0}
					text = "Pikku Saippuakauppias Itkee!!"
					maxWidth = 360
					maxHeight = 18
					format = centre
					fixedsize = yes
				}

				# the mod has one scenario: nothing to change to (the picker opens from New Game only); no "c" shortcut
				ButtonType = {
					name = "scenario_button"
					position = { x = -9000 y = -9000 }
					quadTextureSprite ="GFX_totu_caption_small_118"
					buttonText = ""
					buttonFont = "totu_button_small"
					clicksound = click_ok
				}

				# multiplayer map modes (vanilla icons), under the band
				buttonType = {
					name = "mapmode_button_1"
					position = { x=-40 y=185 }
					quadTextureSprite ="GFX_lobby_country_mapmode_strip"
					clicksound = land_mapmode
					shortcut = "F1"
					pdx_tooltip = "MAPMODE_DEFAULT"
					pdx_tooltip_delayed = "MAPMODE_DEFAULT_DESCRIPTION"
					frame = 1
					centerPosition = yes
				}
				buttonType = {
					name = "mapmode_button_1_s"
					position = { x=-40 y=185 }
					quadTextureSprite ="GFX_lobby_country_mapmode_strip_selected"
					shortcut = "F1"
					pdx_tooltip = "MAPMODE_DEFAULT"
					pdx_tooltip_delayed = "MAPMODE_DEFAULT_DESCRIPTION"
					frame = 1
					centerPosition = yes
				}

				buttonType = {
					name = "mapmode_button_2"
					position = { x=30 y=185 }
					quadTextureSprite ="GFX_lobby_country_mapmode_strip"
					clicksound = land_mapmode
					shortcut = "F2"
					pdx_tooltip = "MAPMODE_PLAYERS"
					frame = 2
					centerPosition = yes
				}
				buttonType = {
					name = "mapmode_button_2_s"
					position = { x=30 y=185 }
					quadTextureSprite ="GFX_lobby_country_mapmode_strip_selected"
					shortcut = "F2"
					pdx_tooltip = "MAPMODE_PLAYERS"
					frame = 2
					centerPosition = yes
				}
			}

			# small plates from x 180: the text starts at 192, capitals y 35..49 / 63..77 / 91..105
			ButtonType = {
				name = "interesting_countries_button"
				position = { x = 180 y = 30 }
				quadTextureSprite ="GFX_totu_caption_small_226"
				buttonText = "TOTU_FE_INTERESTING"
				buttonFont = "totu_button_small"
				Orientation = "UPPER_LEFT"
				clicksound = click_default
				oversound = ui_menu_over
				shortcut = "i"
			}

			ButtonType = {
				name = "randomize_country_button"
				position = { x = 180 y = 58 }
				quadTextureSprite ="GFX_totu_caption_small_214"
				buttonText = "TOTU_FE_RANDOM"
				buttonFont = "totu_button_small"
				Orientation = "UPPER_LEFT"
				clicksound = click_default
				oversound = ui_menu_over
				shortcut = "r"
			}

			ButtonType = {
				name = "observer_button"
				position = { x = 180 y = 86 }
				quadTextureSprite ="GFX_totu_caption_small_154"
				buttonText = "TOTU_FE_OBSERVER"
				buttonFont = "totu_button_small"
				Orientation = "UPPER_LEFT"
				clicksound = click_default
				oversound = ui_menu_over
			}

			iconType ={
				name ="observer_button_overlay"
				spriteType = "GFX_observer_button_overlay"
				position = { x = -9000 y = -9000 } # TotU: no pulsing ring
				Orientation = "UPPER_LEFT"
				alwaystransparent = yes
			}

			# the flag, 82x52, its right edge on W - 192
			ButtonType = {
				position = { x= -274 y = 30 }
				name = "player_shield"
				quadTextureSprite ="GFX_player_flag"
				Orientation = "UPPER_RIGHT"
			}

			iconType ={
				name ="large_flag_frame"
				spriteType = "GFX_large_flag_frame"
				position = { x= -9000 y = -9000 } # TotU: no frame
				Orientation = "UPPER_RIGHT"
			}

			iconType ={
				name ="selected_nation_label_bg"
				spriteType = "GFX_generic_bg"
				position = { x= -9000 y = -9000 } # TotU: no plate
				Orientation = "UPPER_RIGHT"
			}

			# right-aligned 16 px left of the flag, up to 3 lines (capitals from y 35)
			instantTextBoxType = {
				name = "selected_nation_label"
				position = { x = -530 y = 35 }
				textureFile = ""
				font = "totu_caption_name"
				text_color_code = P
				borderSize = {x = 0 y = 0}
				text = "FE_NO_COUNTRY_SELECTED"
				maxWidth = 240
				maxHeight = 54
				fixedsize = yes
				format = right
				Orientation = "UPPER_RIGHT"
			}

			# shows / hides gamesetup_country_details; frame 2 (keyer blue) like the vanilla arrow's second frame
			ButtonType = {
				position = { x= -297 y = 90 }
				name = "extended_country_button"
				quadTextureSprite ="GFX_totu_toggle"
				buttonText = "TOTU_FE_DETAILS"
				buttonFont = "totu_button_small"
				Orientation = "UPPER_RIGHT"
				clicksound = click_default
				oversound = ui_menu_over
			}

		}

		containerWindowType = {
			name ="bottom"
			position = { x=0 y =0}
			show_position = { x=0 y =-160 }
			animation_type = decelerated
			animation_time = 1000
			size = { width=100% height =160}
			Orientation = lower_left
			clipping = no

			containerWindowType = {
				name = background
				size = { width=100% height=100% }
				Background ={
					name ="bottom_win"
					spriteType = "GFX_totu_band_bottom"
					alwaystransparent = yes
				}
			}

			# the menu's last row: plates H-112..H-72 from x 170, the text from 192
			ButtonType = {
				name = "back_button"
				position = { x = 170 y = 48 }
				quadTextureSprite ="GFX_totu_caption_160"
				buttonText = "TOTU_FE_BACK"
				buttonFont = "totu_button"
				Orientation = "UPPER_LEFT"
				clicksound = click_close
				oversound = ui_menu_over
				shortcut = "ESCAPE"
			}

			ButtonType = {
				name = "load_button"
				position = { x = 330 y = 48 }
				quadTextureSprite ="GFX_totu_caption_256"
				buttonText = "TOTU_FE_LOAD"
				buttonFont = "totu_button"
				Orientation = "UPPER_LEFT"
				clicksound = click_default
				oversound = ui_menu_over
				shortcut = "l"
			}

			ButtonType = {
				name = "options_button"
				position = { x = 586 y = 48 }
				quadTextureSprite ="GFX_totu_caption_256"
				buttonText = "TOTU_FE_OPTIONS"
				buttonFont = "totu_button"
				Orientation = "UPPER_LEFT"
				clicksound = click_default
				oversound = ui_menu_over
				shortcut = "o"
			}

			# a mod changes the checksum, so achievements are off anyway: no trophy medallion
			iconType = {
				name = "enabled_achievement_icons"
				position = { x = -9000 y = -9000 }
				quadTextureSprite ="GFX_enabled_achievement_icons"
				Orientation = "LOWER_RIGHT"
			}

			# Start: text ends on W - 192 (the engine centres it 20 px into the 160 plate)
			ButtonType = {
				name = "play_button"
				position = { x = -328 y = -112 }
				quadTextureSprite ="GFX_totu_caption_160"
				buttonText = "TOTU_FE_START"
				buttonFont = "totu_button"
				Orientation = "LOWER_RIGHT"
				#clicksound = start_game_01 # Don't add this here. I intentionally removed it because otherwise the sound is played when the client clicks on Ready/Unready button. The sound should only play when the host starts the game (or when it's SP) which is done in the code.
				shortcut = "RETURN"
			}

			ButtonType = {
				name = "play_button_ready"
				position = { x = -328 y = -112 }
				quadTextureSprite ="GFX_totu_caption_160"
				buttonText = "TOTU_FE_READY"
				buttonFont = "totu_button"
				Orientation = "LOWER_RIGHT"
				#clicksound = start_game_01 # see play_button
				shortcut = "RETURN"
			}

			# the client's ready state, 20x20, 12 px before the Ready plate, centred on it
			iconType = {
				name = "play_button_checkbox"
				position = { x = -360 y = -102 }
				quadTextureSprite ="GFX_totu_checkbox"
				Orientation = "LOWER_RIGHT"
				alwaystransparent = yes
			}

		}
	}
}

	### SCENARIO PICKER (TotU "broadcast"; design tools/preview/screen_scenario.png, layout SCEN_* in
	# tools/build_menu_gfx.py). Screen px at UI scale 1.0, W x H = screen.
	# The main menu's title block (mainmenu_panel_upperleft: logo + date, position = show_position) stays on screen as
	# a station ident, so this screen repeats neither the title nor the date. It adds:
	#   - one inset in the lower right corner (LOWER_RIGHT): the bookmark still (512x288, x W-704..W-192,
	#     y H-488..H-200) with a flat near-black board flush under it (512x128, the scenario text, to H-72 = the menu's
	#     last plate bottom), seated in its own soft scrim. Sized for 1280x720: left of it the logo ends at x 542 on
	#     the "OF THE" line, above it the "TWILIGHT" line ends at y 178 (from 1366x768 up it clears the logo box);
	#   - Select and Back in the menu's Credits / Quit rows: transparent plates that turn keyer blue on hover, labels
	#     as left-aligned caption boxes at x = 192 with the black K copy at +2,+2 (as in frontendmainview.gui).
	# Every element the engine looks up by name stays a direct child of this window; the unused ones are off-screen.
	# The lobby's Change Scenario button is off-screen (one scenario), so the picker only opens from New Game, over the
	# main menu. If size %% fails for the height: size = { width = 1920 height = 1080 min = { width = 100% height =
	# 100% } max = { width = 100% height = 100% } } (the frontend_background syntax).
	containerWindowType = {
		name ="gamesetup_scenario_window"
		position = { x = 0 y = 0 }
		size = { width = 100%% height = 100%% }
		Orientation = UPPER_LEFT
		clipping = no
		moveable = no

		# transparent, but it catches clicks, so nothing behind the window reacts
		background = {
			name = "single_player_date_bg"
			quadTextureSprite ="GFX_tiled_window_transparent"
		}

		# the inset's own shadow: 992x936, the column + 240 / 260 px each side
		iconType = {
			name = "totu_scen_scrim"
			spriteType = "GFX_totu_scrim_scenario"
			Orientation = LOWER_RIGHT
			position = { x = -944 y = -788 }
			alwaystransparent = yes
		}

		# the main menu's scrim under the two captions (H - 500)
		iconType = {
			name = "totu_scen_menu_scrim"
			spriteType = "GFX_totu_scrim_menu"
			Orientation = LOWER_LEFT
			position = { x = -222 y = -500 }
			alwaystransparent = yes
		}

		# The still: one bookmark_entry. The grid clips to one slot; the hidden clone of the bookmark
		# (common/bookmarks/totu_1990.txt, tools/build_bookmarks.py) lands in slot 2 at x = 1000, outside the clip.
		containerWindowType = {
			name ="bookmarks"
			Orientation = LOWER_RIGHT
			position = { x = -704 y = -528 }
			size = { width = 512 height = 288 }
			clipping = yes

			gridboxType = {
				name ="bookmarks_grid"
				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 1000 height = 0 }
				add_horizontal = yes
				max_slots_vertical = 1
				format = "UPPER_LEFT"
			}
		}

		# the board, flush under the still: 512x168, alpha 82 %, ending at H - 72
		iconType = {
			name = "totu_scen_board"
			spriteType = "GFX_select_date_bg"
			Orientation = LOWER_RIGHT
			position = { x = -704 y = -240 }
			alwaystransparent = yes
		}

		# TOTU_1990_DESC (engine-filled): 22 px in, 14 px down, 468x140 = 7 lines of 20 (RU 6 in game), centred vertically
		instantTextBoxType = {
			name = "bookmark_desc"
			Orientation = LOWER_RIGHT
			position = { x = -682 y = -226 }
			font = "totu_body"
			text_color_code = P
			borderSize = { x = 0 y = 0 }
			maxWidth = 468
			maxHeight = 140
			fixedsize = yes
			format = left
			vertical_alignment = center
			alwaystransparent = yes
		}

		# The main menu's title block is hidden on this screen, so the window carries its own (same positions as the
		# menu: scrim, logo with glyphs from 192,108, start date). Window title and history title stay off-screen.
		iconType = {
			name = "totu_scen_title_scrim"
			spriteType = "GFX_totu_scrim_title"
			position = { x = -123 y = -67 }
			alwaystransparent = yes
		}

		iconType = {
			name = "totu_scen_logo"
			spriteType = "GFX_frontend_game_logo"
			position = { x = 156 y = 72 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "totu_scen_date_edge"
			position = { x = 194 y = 390 }
			font = "totu_caption_small"
			text_color_code = K
			borderSize = { x = 0 y = 0 }
			text = "TOTU_MENU_START_DATE"
			format = left
			maxWidth = 600
			maxHeight = 20
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "totu_scen_date"
			position = { x = 192 y = 388 }
			font = "totu_caption_small"
			text_color_code = P
			borderSize = { x = 0 y = 0 }
			text = "TOTU_MENU_START_DATE"
			format = left
			maxWidth = 600
			maxHeight = 20
			alwaystransparent = yes
		}

		# scenario name (engine-filled, TOTU_1990_NAME) as a caption over the still
		instantTextBoxType = {
			name = "bookmark_title"
			Orientation = LOWER_RIGHT
			position = { x = -704 y = -576 }
			font = "totu_caption"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			maxWidth = 512
			maxHeight = 40
			format = left
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "history_title"
			position = { x = -9000 y = -9000 }
			font = "hoi_20b"
			borderSize = {x = 0 y = 0}
			text = "BM_HISTORY_TITLE"
			maxWidth = 300
			maxHeight = 26
			format = left
		}

		instantTextBoxType = {
			name = "title"
			position = { x = -9000 y = -9000 }
			textureFile = ""
			font = "hoi_24header"
			borderSize = {x = 0 y = 0}
			text = "FE_SELECT_SCENARIO"
			maxWidth = 400
			maxHeight = 30
			format = left

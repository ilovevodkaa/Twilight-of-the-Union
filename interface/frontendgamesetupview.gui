	### LOAD GAME (TotU "broadcast"): a flat near-black board on the right title-safe edge (right edge W - 170, so the
	# text measure ends at W - 192; bottom H - 132, above the menu's changelog line), sliding in from the right. The
	# single-player captions stay visible on the left. Tabs are keyer chips (the selected one blue), the labels are
	# vanilla strings in totu_caption_name. The save entries come from ingamemenu.gui (savegame_item), shared with the
	# in-game menu, and keep their look.
	containerWindowType = {
		name ="gamesetup_load"
		position = { x = 600 y = -632 }
		show_position = { x = -590 y = -632 }
		animation_type = decelerated
		animation_time = 1000
		size = { width = 420 height = 500}
		Orientation = lower_right

		background = {
			name = "totu_load_board"
			quadTextureSprite = "GFX_totu_board"
		}

		iconType = {
			name ="menu"
			spriteType = "GFX_load_save_top_screen"
			position = { x = -9000 y = -9000 } # TotU: the board is the surface
			Orientation = "UPPER_LEFT"
		}

		iconType = {
			name ="menu_bottom"
			spriteType = "GFX_load_save_bottom_screen"
			position = { x = -9000 y = -9000 }
			Orientation = "UPPER_LEFT"
		}

		instantTextBoxType = {
			name = "saves_dirs"
			position = { x = 22 y = 468 }
			font = "totu_caption_name"
			text_color_code = D
			borderSize = {x = 0 y = 0}
			maxWidth = 376
			maxHeight = 18
			format = left
			fixedsize = yes
			truncate = yes
		}

		checkboxType = {
			name = "localgames_tab"
			position = { x = 22 y = 22 }
			quadTextureSprite ="GFX_totu_tab"
			Orientation = "UPPER_LEFT"
			clicksound = click_checkbox
		}

		checkboxType = {
			name = "remotegames_tab"
			position = { x = 140 y = 22 }
			quadTextureSprite ="GFX_totu_tab"
			Orientation = "UPPER_LEFT"
			clicksound = click_checkbox
		}

		instantTextBoxType = {
			name = "localgames_label"
			position = { x = 22 y = 27 }
			font = "totu_caption_name"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			text = "MENU_BAR_LOCALGAMES"
			maxWidth = 112
			maxHeight = 18
			fixedsize = yes
			Orientation = "UPPER_LEFT"
			format = centre
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "cloudgames_label"
			position = { x = 140 y = 27 }
			font = "totu_caption_name"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			text = "MENU_BAR_CLOUDGAMES"
			maxWidth = 112
			maxHeight = 18
			fixedsize = yes
			Orientation = "UPPER_LEFT"
			format = centre
			alwaystransparent = yes
		}

		containerWindowType = {
			name ="games"
			position = { x = 8 y = 60 }
			size = { width = 404 height = 396}
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 55
			smooth_scrolling = yes

			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window_transparent"
			}

			gridBoxType = {
				name = "games_grid"
				position = { x=14 y =4}
				size = { width =280 height = 100%% }
				slotsize = { width = 280 height = 55 }
				format = "UPPER_LEFT"
				max_slots_horizontal = 1
			}
		}
	}


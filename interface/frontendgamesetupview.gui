			text = "FE_DIFFICULTY_HARD"
			format = centre
			alwaystransparent = yes
		}

		instantTextBoxType={
			position = {x=462 y=47 }
			name = "very_hard_text"
			font = "totu_caption_name"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			maxWidth = 104
			maxHeight = 18
			fixedsize = yes
			text = "FE_DIFFICULTY_VERY_HARD"
			format = centre
			alwaystransparent = yes
		}

		instantTextBoxType={
			position = {x = 50 y = 82 }
			name = "ironman_text"
			font = "totu_caption_name"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			maxWidth = 520
			maxHeight = 18
			text = "FE_IRONMAN"
			pdx_tooltip = "FE_IRONMAN_TOOLTIP"
			format = left
			fixedsize = yes
		}

		checkboxType = {
			name = "ironman_cb"
			position = { x=22 y =79}
			quadTextureSprite ="GFX_totu_checkbox"
			clicksound = click_checkbox
		}

		instantTextBoxType={
			position = {x = 50 y = 110 }
			name = "historical_text"
			font = "totu_caption_name"
			text_color_code = P
			borderSize = {x = 0 y = 0}
			maxWidth = 520
			maxHeight = 18
			text = "FE_HISTORICAL"
			pdx_tooltip = "FE_HISTORICAL_TOOLTIP"

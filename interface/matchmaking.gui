# Twilight of the Union: multiplayer server browser in the broadcast style (full copy of vanilla 1.19.3
# interface/matchmaking.gui; every vanilla element name and type is kept).
# One flat board 1022x560 (it overlays frontendmultiplayerview exactly, which is drawn on top and holds the player
# name field, the version and the "Server ID" plate). Title (22,22); tabs on row 52 with the refresh plates
# right-aligned; filter band rows 88 / 120 / 152; column headers on row 196 (GFX_totu_mp_sort_*, built by
# tools/build_mp_gfx.py); list 224..488; plate row 520..560 inside the bottom edge: Back at x 0, Join / Host (slate)
# right-aligned.
guiTypes = {
	containerWindowType = {
		name = "matchmaking_window"
		position = { x=0 y=0 }
		size = { width=1022 height=560 }
		Orientation = center
		Origo = center

		background = {
			name = "totu_board"
			quadTextureSprite = "GFX_totu_board"
		}

		containerWindowType = {
			name = "matchmaking_servers_window"

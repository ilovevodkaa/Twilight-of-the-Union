guiTypes = {
#################################################
### CreditScreen interface ##########################
#################################################
# TotU: full copy of vanilla 1.19.3 interface/credits.gui (frontend only). The engine builds the credits roll from
# these two templates (interface/credits.txt: lines starting with # use CreditsTextBold). Broadcast "end credits":
# names in the pixel caption font, dim D; headings in the pixel header font (hoi_24header = totu_h24 with accent
# marks, vanilla glyph fallback), paper white P. Sizes and positions are vanilla (the engine stacks the lines).

	instantTextBoxType = {
		name = "CreditsText"
		textureFile = ""
		font = "totu_caption_name"		# TotU: pixel names (vanilla hoi_18mbs)
		text_color_code = D
		borderSize = {x = 0 y = 0}
		position = { x= 0 y= 0 }
		text = ""
		fixedsize = yes
		maxwidth = 500
		maxheight = 32
		format = centre
		orientation = "CENTER"
	}

	instantTextBoxType = {
		name = "CreditsTextBold"
		textureFile = ""
		font = "totu_h24"			# TotU: pixel header atlas totu_h24 (core.gfx)
		text_color_code = P
		borderSize = {x = 0 y = 0}
		position = { x= 0 y= 0 }
		text = ""
		fixedsize = yes
		maxwidth = 500
		maxheight = 32
		format = centre
		orientation = "CENTER"
	}



	iconType =
	{
		name = "CreditsBar"
		buttonMesh = "MenuCreditsBg"
		position = { x= -412 y =-382}
		orientation = "CENTER"
	}

	windowType = {
	name ="CreditsWindow"
	backGround=""
	position = { x=-210 y =-180}
	size = { x=420 y =500}
	moveable = 0
	dontRender = ""
	horizontalBorder= ""
	verticalBorder= ""
	fullscreen=no
	Orientation = "CENTER"

		iconType =
		{
			name ="credits_bg"
			spriteType = "GFX_credits_bg"
			position = { x= -265 y =-459}
			orientation = "CENTER"
		}

	guiButtonType = {
		name = "back_button"
		position = { x = 146 y = 416 }
		quadTextureSprite ="button_type_1"
		buttonText = "BACK"
		buttonFont = "hoi_16mbs"
		clicksound = click_close
	}



	### TITLE (TotU "broadcast" menu; design: tools/preview/menu_dir_broadcast.png, sprites and fonts built by tools/)
	# The programme title in the title-safe corner: a shadow scrim, the pixel logo and the start date.
	# The logo texture has a 36 px pad, so its glyphs start at 192,108; the date line shares the x = 192 edge.
	# position = show_position: the vanilla slide-in is switched off, broadcast captions do not move.
	# Caption text boxes (here and in the menus below): the totu_caption fonts put the capitals at the line top, so a
	# box's y is the top of its capitals. Every caption has a black copy (text_color_code K) at +2,+2 declared before
	# it: the drop edge. P is the logo's glyph white (interface/totu_fonts.gfx).
	containerWindowType = {
		name  ="mainmenu_panel_upperleft"
		position = { x=0 y =0 }
		show_position = { x=0 y =0 }
		animation_type = decelerated
		animation_time = 1000
		size = { width = 800 height = 440 }
		Orientation = UPPER_LEFT
		clipping = no

		iconType = {
			name = "totu_title_scrim"
			spriteType = "GFX_totu_scrim_title"
			position = { x = -123 y = -67 }
			alwaystransparent = yes
		}

		iconType =
		{
			name ="frontend_game_logo"
			spriteType = "GFX_frontend_game_logo"
			position = { x = 156 y = 72 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "totu_start_date_edge"
			position = { x = 194 y = 390 }
			font = "totu_caption_small"
			text_color_code = K
			borderSize = { x = 0 y = 0 }
			text = "TOTU_MENU_START_DATE"
			format = left
			vertical_alignment = top
			maxWidth = 500
			maxHeight = 20
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "totu_start_date"
			position = { x = 192 y = 388 }
			font = "totu_caption_small"
			text_color_code = P
			borderSize = { x = 0 y = 0 }
			text = "TOTU_MENU_START_DATE"
			format = left
			vertical_alignment = top
			maxWidth = 500
			maxHeight = 20
			alwaystransparent = yes
		}
	}


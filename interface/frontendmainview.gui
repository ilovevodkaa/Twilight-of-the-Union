	### MAIN MENU (TotU "broadcast" layout, see the TITLE comment above)
	# Keyed lower-third captions: no panel, a shadow scrim, transparent plates that turn keyer blue on hover.
	# The container is a 500 px band along the bottom of the screen, full width. Its top-left corner is pinned
	# (Orientation LOWER_LEFT, y = -500, default origo), and every left-hand child hangs from that corner,
	# so y = 500 - (distance of the item's top from the screen bottom).
	# Plates: x = 170, 40 px tall, pitch 44, 20 px gap before Quit. The buttons draw only the plate; the label is a
	# left-aligned text box at x = 192, y = plate + 6, so every label starts on the same edge in both languages
	# (button text would be centred in a plate sized to the longer of the RU and EN label).
	# No subscription_size, subscription_divider or subscription_widget*: while the subscription widget is shown the
	# engine resizes this window to subscription_size, which would move the right-anchored lines below, and a size
	# in percent is not known to work there. Road to 56 removes the same elements on 1.19; the engine only logs them.
	containerWindowType = {
		name ="mainmenu_panel_bottom"
		position = { x = 0 y = -500 }
		size = { width = 100%% height = 500 }
		Orientation = LOWER_LEFT
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_window_transparent"
			alwaystransparent = yes
		}

		iconType = {
			name = "totu_menu_scrim"
			spriteType = "GFX_totu_scrim_menu"
			position = { x = -222 y = 0 }		# H - 500
			alwaystransparent = yes
		}

		ButtonType = {
			name = "single_player_button"
			position = { x = 170 y = 192 }		# H - 308
			quadTextureSprite ="GFX_totu_caption_376"

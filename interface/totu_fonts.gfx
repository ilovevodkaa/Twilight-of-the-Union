# Twilight of the Union: caption fonts of the main menu (design "broadcast", Soviet TV captions).
# gfx/fonts/totu_caption*.fnt and .dds are generated by tools/build_fonts.py; edit the script, not the files.
#   totu_caption        4 px cells: 20x28 glyphs, advance 24, lineHeight 36, base 28 (menu labels)
#   totu_caption_small  2 px cells: 10x14 glyphs, advance 12, lineHeight 18, base 14 (date, changelog, version)
# One file per font holds Latin and Cyrillic, like vanilla hoi_33. Lowercase renders as capitals.
# The capitals start at the line top, so a top-aligned text box's y is the top of its capitals.
# Colour codes (text_color_code or a section-sign code in loc), RGB like the global ones in core.gfx:
#   P logo glyph white (every caption), D dim grey (engine version), K black (the drop-edge copy of each caption at
#   +2,+2 in interface/frontendmainview.gui). The atlas is white, the engine tints it with the code's colour.
# The loading screen's fonts (the same glyphs with the K edge baked in) are in interface/load_screen_font.gfx: the
# engine reads that file before this one.
# K-edged fonts (the black drop edge at +2,+2 baked into the atlas, so one text box draws caption and edge):
#   totu_button         4 px cells, lineHeight 40 = the big plate, capitals 6..34: engine-centred buttonText
#   totu_button_small   2 px cells, lineHeight 24 = the small plate, capitals 5..19: engine-centred buttonText
#   totu_label          2 px cells, lineHeight 18 (totu_caption_small_k): small captions from TOTU_* keys
#   totu_caption_name   the same atlas as totu_label, for text the engine fills in (country names, the date, vanilla
#                       labels): Japanese, Simplified Chinese and Korean get the vanilla hoi_16mbs there, because those
#                       names come from vanilla localisation and the pixel font has no CJK glyphs. Latin-script names
#                       render through the accent aliases (tools/build_fonts.py checks every name).
# totu_body: body text of the scenario board, vanilla Ubuntu Light 20 (hoi_20b) tinted with the caption white. Not the
# pixel font: about 225 characters on 3 lines read badly in 5x7 capitals, and the other languages' fallback text must
# still render. Japanese, Simplified Chinese and Korean get the vanilla hoi_20b of their language (popups, descriptions).
# totu_list: dense lists of user and engine text (save names, server names, track list, achievement descriptions):
#   vanilla Ubuntu 16 (hoi_16mbs + hoi_16mbs_cryllic, lineHeight 16), colour P, codes P D K and the vanilla G R Y H O;
#   Japanese, Simplified Chinese and Korean as vanilla hoi_16mbs.
# The in-game header fonts hoi_36header / hoi_30header / hoi_24header are redefined in interface/core.gfx (pixel atlases
# totu_h36 / totu_h30 / totu_h24, written by tools/build_fonts.py; totu_h24 = the totu_button_small glyphs plus accent
# marks); core.gfx also adds the global codes P D K, so a section-sign P / D / K works in every font.
# Text keys: TOTU_FE_* / TOTU_IG_* / TOTU_MENU_* for text in these pixel fonts (glyph-checked), TOTU_TXT_* for text in
# vanilla fonts (totu_body, totu_list), all in localisation/<lang>/totu_menu*_l_<lang>.yml (tools/fontcheck/README.txt).

bitmapfonts = {

	bitmapfont = {
		name = "totu_caption"
		fontfiles = {
			"gfx/fonts/totu_caption"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }		# logo glyph white (tools/build_menu_gfx.py, CAPTION_WHITE)
			D = { 172 180 196 }		# dim grey; do not go darker (contrast over the pavement)
			K = { 0 0 0 }			# black
		}
	}

	bitmapfont = {
		name = "totu_caption_small"
		fontfiles = {
			"gfx/fonts/totu_caption_small"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/hoi_20b"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }		# caption white
		}
	}

	# as vanilla hoi_20b: the Cyrillic glyphs live in a second file
	bitmapfont_override = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/hoi_20b"
			"gfx/fonts/hoi_20b_cryllic"
		}
		languages = { "l_russian" "l_polish" }
	}

	# as vanilla hoi_20b (interface/core.gfx, core_chinese.gfx, core_korean.gfx)
	bitmapfont_override = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/japanese/hoi_20b"
		}
		languages = { "l_japanese" }
	}

	bitmapfont_override = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/chinese/hoi_20b_1of4EX"
			"gfx/fonts/chinese/hoi_20b_2of4EX"
			"gfx/fonts/chinese/hoi_20b_3of4EX"
			"gfx/fonts/chinese/hoi_20b_4of4EX"
		}
		languages = { "l_simp_chinese" }
	}

	bitmapfont_override = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/korean/hoi_20b"
		}
		languages = { "l_korean" }
	}

	bitmapfont = {
		name = "totu_list"
		fontfiles = {
			"gfx/fonts/hoi_16mbs"
			"gfx/fonts/hoi_16mbs_cryllic"
		}
		color = 0xfff6f2ea		# caption white P

		textcolors = {
			P = { 246 242 234 }		# caption white
			D = { 172 180 196 }		# dim grey; do not go darker
			K = { 0 0 0 }			# black
			G = { 86 172 91 }		# vanilla hoi_16mbs semantic colours
			R = { 222 86 70 }
			Y = { 238 201 35 }
			H = { 238 201 35 }
			O = { 238 123 35 }
		}
	}

	# as vanilla hoi_16mbs (interface/core.gfx, core_chinese.gfx, core_korean.gfx)
	bitmapfont_override = {
		name = "totu_list"
		fontfiles = {
			"gfx/fonts/japanese/hoi_16mbs"
		}
		languages = { "l_japanese" }
	}

	bitmapfont_override = {
		name = "totu_list"
		fontfiles = {
			"gfx/fonts/chinese/hoi_16mbs_1of4EX"
			"gfx/fonts/chinese/hoi_16mbs_2of4EX"
			"gfx/fonts/chinese/hoi_16mbs_3of4EX"
			"gfx/fonts/chinese/hoi_16mbs_4of4EX"
		}
		languages = { "l_simp_chinese" }
	}

	bitmapfont_override = {
		name = "totu_list"
		fontfiles = {
			"gfx/fonts/korean/hoi_16mbs"
		}
		languages = { "l_korean" }
	}

	bitmapfont = {
		name = "totu_button"
		fontfiles = {
			"gfx/fonts/totu_button"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_button_small"
		fontfiles = {
			"gfx/fonts/totu_button_small"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_label"
		fontfiles = {
			"gfx/fonts/totu_caption_small_k"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/totu_caption_small_k"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
			Y = { 246 242 234 }		# vanilla highlight codes in engine strings -> caption white
			H = { 246 242 234 }
			R = { 222 86 70 }		# vanilla semantic red / green (errors, +/- values), as in hoi_16mbs
			G = { 86 172 91 }
		}
	}

	# as vanilla hoi_16mbs (interface/core.gfx, core_chinese.gfx, core_korean.gfx); line heights 14..16 fit the boxes
	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/japanese/hoi_16mbs"
		}
		languages = { "l_japanese" }
	}

	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/chinese/hoi_16mbs_1of4EX"
			"gfx/fonts/chinese/hoi_16mbs_2of4EX"
			"gfx/fonts/chinese/hoi_16mbs_3of4EX"
			"gfx/fonts/chinese/hoi_16mbs_4of4EX"
		}
		languages = { "l_simp_chinese" }
	}

	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/korean/hoi_16mbs"
		}
		languages = { "l_korean" }
	}

	# totu_h24: the broadcast teletext header atlas (tools/build_fonts.py) for the restyled menus, with vanilla hoi_24header
	# behind it for any missing glyph (same lineHeight / base) and the vanilla CJK fonts. In game the vanilla header
	# fonts stay as they are (no interface/core.gfx override).
	bitmapfont = {

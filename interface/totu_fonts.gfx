# Twilight of the Union: caption fonts of the main menu (design "broadcast", Soviet TV captions).
# gfx/fonts/totu_caption*.fnt and .dds are generated by tools/build_fonts.py; edit the script, not the files.
#   totu_caption        4 px cells: 20x28 glyphs, advance 24, lineHeight 36, base 28 (menu labels)
#   totu_caption_small  2 px cells: 10x14 glyphs, advance 12, lineHeight 18, base 14 (date, changelog, version)
# One file per font holds Latin and Cyrillic, like vanilla hoi_33. Lowercase renders as capitals.
# The capitals start at the line top, so a top-aligned text box's y is the top of its capitals.
# Colour codes (text_color_code or a section-sign code in loc), RGB like the global ones in core.gfx:
#   P logo glyph white (every caption), D dim grey (engine version), K black (the drop-edge copy of each caption at
#   +2,+2 in interface/frontendmainview.gui). The atlas is white, the engine tints it with the code's colour.
# The loading screen's fonts (the same glyphs with the K edge baked in) are in interface/load_screen_font.gfx: the
# engine reads that file before this one.
# K-edged fonts (the black drop edge at +2,+2 baked into the atlas, so one text box draws caption and edge):
#   totu_button         4 px cells, lineHeight 40 = the big plate, capitals 6..34: engine-centred buttonText
#   totu_button_small   2 px cells, lineHeight 24 = the small plate, capitals 5..19: engine-centred buttonText
#   totu_label          2 px cells, lineHeight 18 (totu_caption_small_k): small captions from TOTU_* keys
#   totu_caption_name   the same atlas as totu_label, for text the engine fills in (country names, the date, vanilla
#                       labels): Japanese, Simplified Chinese and Korean get the vanilla hoi_16mbs there, because those
#                       names come from vanilla localisation and the pixel font has no CJK glyphs. Latin-script names
#                       render through the accent aliases (tools/build_fonts.py checks every name).
# totu_body: body text of the scenario board, vanilla Ubuntu Light 20 (hoi_20b) tinted with the caption white. Not the
# pixel font: about 225 characters on 3 lines read badly in 5x7 capitals, and the other languages' fallback text must
# still render.

bitmapfonts = {

	bitmapfont = {
		name = "totu_caption"
		fontfiles = {
			"gfx/fonts/totu_caption"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }		# logo glyph white (tools/build_menu_gfx.py, CAPTION_WHITE)
			D = { 172 180 196 }		# dim grey; do not go darker (contrast over the pavement)
			K = { 0 0 0 }			# black
		}
	}

	bitmapfont = {
		name = "totu_caption_small"
		fontfiles = {
			"gfx/fonts/totu_caption_small"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/hoi_20b"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }		# caption white
		}
	}

	# as vanilla hoi_20b: the Cyrillic glyphs live in a second file
	bitmapfont_override = {
		name = "totu_body"
		fontfiles = {
			"gfx/fonts/hoi_20b"
			"gfx/fonts/hoi_20b_cryllic"
		}
		languages = { "l_russian" "l_polish" }
	}

	bitmapfont = {
		name = "totu_button"
		fontfiles = {
			"gfx/fonts/totu_button"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_button_small"
		fontfiles = {
			"gfx/fonts/totu_button_small"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_label"
		fontfiles = {
			"gfx/fonts/totu_caption_small_k"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
		}
	}

	bitmapfont = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/totu_caption_small_k"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
			Y = { 246 242 234 }		# vanilla highlight codes in engine strings -> caption white
			H = { 246 242 234 }
		}
	}

	# as vanilla hoi_16mbs (interface/core.gfx, core_chinese.gfx, core_korean.gfx); line heights 14..16 fit the boxes
	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/japanese/hoi_16mbs"
		}
		languages = { "l_japanese" }
	}

	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/chinese/hoi_16mbs_1of4EX"
			"gfx/fonts/chinese/hoi_16mbs_2of4EX"
			"gfx/fonts/chinese/hoi_16mbs_3of4EX"
			"gfx/fonts/chinese/hoi_16mbs_4of4EX"
		}
		languages = { "l_simp_chinese" }
	}

	bitmapfont_override = {
		name = "totu_caption_name"
		fontfiles = {
			"gfx/fonts/korean/hoi_16mbs"
		}
		languages = { "l_korean" }
	}
}

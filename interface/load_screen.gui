# Twilight of the Union: loading screen.
# Layout: logo top-left; tip box and status box stacked at the bottom centre.
# Box textures come from tools/build_menu_gfx.py (LOAD_* constants).
guiTypes = {

	windowType = {
		name = "load_screen"
		backGround =""
		position = { x = 0 y = 0 }
		size = { x = 1024 y = 768 }
		moveable = 0
		dontRender = ""
		horizontalBorder = "0"
		verticalBorder = ""
		fullScreen = yes
		Orientation = "UPPER_LEFT"

		iconType = {
			name = "totu_loading_logo"
			spriteType = "GFX_totu_loading_logo"
			position = { x = 30 y = 26 }
			scale = 0.75
		}

		# Vanilla logos: the engine looks these up by name, so they stay, off-screen.
		iconType = {
			name ="bg_clausewitz_logo"
			spriteType = "GFX_clausewitz_logo"
			position = { x = -9000 y = -9000 }
		}

		iconType = {
			name ="bg_pdx_int_logo"
			spriteType = "GFX_frontend_dev_logo_s"
			position = { x = -9000 y = -9000 }
		}

		# Origin of a CENTER_DOWN window is the bottom centre of the screen.
		windowType = {
			name = "status"
			backGround =""
			position = { x = 0 y = 0 }
			size = { x = 1024 y = 768 }
			moveable = 0
			dontRender = ""
			horizontalBorder = "0"
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER_DOWN"

			iconType = {
				name ="bg_load_screen2"
				spriteType = "GFX_loadingstatus_bg"
				position = { x = -550 y = -120 }
			}

			instantTextBoxType = {
				name = "text"
				position = { x = -400 y = -108 }
				textureFile = ""
				font = "loadscreen_header"
				borderSize = {x = 0 y = 0}
				text = ""
				maxWidth = 800
				maxHeight = 40
				fixedsize = yes
				format = centre
			}

			iconType = {
				name = "progressbar"
				spriteType = "GFX_loadingstatus_progress"
				position = { x = -467 y = -56 }
			}
		}

		windowType = {
			name = "tip"
			backGround =""
			position = { x = 0 y = 0 }
			size = { x = 1024 y = 200 }
			moveable = 0
			dontRender = ""
			horizontalBorder = "0"
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER_DOWN"

			iconType = {
				name ="bg_load_screen"
				spriteType = "GFX_loadingtip_bg"
				position = { x = -550 y = -228 }
			}

			instantTextBoxType = {
				name = "text"
				position = { x = -500 y = -226 }
				textureFile = ""
				font = "loadscreen_tip"
				borderSize = {x = 0 y = 0}
				text = ""
				maxWidth = 1000
				maxHeight = 100
				fixedsize = yes
				format = centre
				vertical_alignment = center
			}
		}
	}
}

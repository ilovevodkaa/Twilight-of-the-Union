			name = "saves_dirs"
			position = { x = 22 y = 412 }
			textureFile = ""
			font = "totu_caption_name"
			text_color_code = D
			borderSize = {x = 0 y = 0}
			text = ""
			maxWidth = 376
			maxHeight = 18

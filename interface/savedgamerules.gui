				format = "UPPER_LEFT"
				max_slots_horizontal = 1
			}
		}

		iconType =
		{
			name ="menu"
			spriteType = "GFX_load_save_top_screen"
			position = { x = -9000 y = -9000 } # TotU: the board is the surface
			Orientation = "UPPER_LEFT"
		}

		iconType =
		{
			name ="menu_bottom"
			spriteType = "GFX_load_save_bottom"

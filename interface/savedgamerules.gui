# Twilight of the Union: saved game rules (rule presets), a full copy of vanilla 1.19.3 interface/savedgamerules.gui
# restyled in the "broadcast" style (area "rules"). Every vanilla element keeps its name and type; unused art is at
# -9000 with a TotU comment.
# Both boards copy the mod's gamesetup_ironman_save layout: a centred 420x500 GFX_totu_board, title at (22,22), the
# Local / Cloud tabs on GFX_totu_tab at (22,48) / (140,48), the list at (8,84) (412 wide: the kit scrollbar sits at
# board x 403..415, clear of the entries) with 376x52 slots on the 22 px measure, Back (transparent plate) at x 0
# and the action (slate plate) right-aligned inside the bottom edge. Entries (savedgamerules_item) are 376x48 like
# the shared savegame_item: GFX_totu_save_entry rows.

guiTypes = {
	containerWindowType = {
		name ="savedgamerules_load"
		position = { x = -210 y = -250 }
		size = { width = 420 height = 500}
		Orientation = center

		background = {
			name = "totu_rules_load_board"
			quadTextureSprite = "GFX_totu_board"
		}

		instantTextBoxType = {
			name = "totu_rules_load_title"
			position = { x = 22 y = 22 }
			font = "totu_caption_name"
			text_color_code = P
			borderSize = { x = 0 y = 0 }
			text = "CUSTOM_GAME_SETTINGS_LOAD"
			maxWidth = 376
			maxHeight = 18
			fixedsize = yes
			format = left
		}

		containerWindowType = {
			name ="savedgamerules"

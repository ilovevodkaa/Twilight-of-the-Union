	# preset entry: 376x48 like the shared savegame_item; GFX_totu_save_entry (transparent / keyer plate with tail),
	# name in totu_list P (user text), date in totu_list D, the kit x for delete
	containerWindowType = {
		name ="savedgamerules_item"
		position = { x=0 y =0 }
		size = { width = 376 height = 48 }
		clipping = no

		buttonType = {
			name = "BackgroundButton"
			quadTextureSprite ="GFX_totu_save_entry"
		}

		instantTextBoxType={
			position = {x = 12 y = 7 }
			name = "name"
			font = "totu_list"
			text_color_code = P
			borderSize = { x = 0 y = 0 }
			maxWidth = 280
			maxHeight = 18
			format = left
			fixedsize = yes
			truncate = yes
			alwaystransparent = yes
		}

		instantTextBoxType={
			position = {x = 12 y = 25 }
			name = "date"
			font = "totu_list"
			text_color_code = D
			borderSize = { x = 0 y = 0 }
			maxWidth = 280
			maxHeight = 18
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}


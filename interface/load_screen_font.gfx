# Twilight of the Union: loading screen fonts (replaces the vanilla file of the same name).
# hoi4.exe reads load_screen.gfx, load_screen.gui and this file before every other interface file, so the fonts of
# the loading screen are declared here and nowhere else (interface/totu_fonts.gfx has the menu's caption fonts).
# gfx/fonts/totu_caption_quote and totu_caption_small_k are generated by tools/build_fonts.py: the menu's caption
# glyphs with its black K drop edge (+2,+2) baked into the atlas. The engine multiplies the atlas colour by the
# text colour, so the edge stays black under P and under the §D of the name strap.
#   loadscreen_tip     totu_caption_quote    4 px cells, 28 px capitals, lineHeight 44 (quote lines + name strap)
#   loadscreen_header  totu_caption_small_k  2 px cells, 14 px capitals, lineHeight 18 (status line)
# Colour codes: P caption white, D dim grey (name strap), K black. Y and H are repainted to P, so the save name in
# HOST_LOADING_SAVEGAME ($NAME|Y$) stays in the caption palette and the progress bar is the only saturated colour.
# Other languages: the status line shows vanilla strings, so languages whose strings need glyphs these fonts lack
# get vanilla fonts that fit its box (one line, at most 32 px). The tips are the mod's quotes in every language
# (English where the mod has no translation: tools/build_fonts.py writes loading_tips_l_<lang>.yml), so the tip
# font is the pixel font everywhere.

bitmapfonts = {

	bitmapfont = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/totu_caption_small_k"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }		# caption white (tools/build_menu_gfx.py, CAPTION_WHITE)
			D = { 172 180 196 }		# dim grey (CAPTION_DIM)
			K = { 0 0 0 }			# black
			G = { 86 172 91 }
			R = { 222 86 70 }
			Y = { 246 242 234 }		# vanilla yellow -> caption white
			H = { 246 242 234 }		# vanilla highlight -> caption white
			T = { 255 255 255 }
		}
	}

	bitmapfont_override = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/hoi_20bs"
			"gfx/fonts/hoi_20bs_cryllic"
		}
		languages = { "l_polish" }
	}

	bitmapfont_override = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/hoi_18mbs"
		}
		languages = { "l_french" "l_german" "l_spanish" "l_braz_por" }
	}

	bitmapfont_override = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/japanese/hoi_24header"
		}
		languages = { "l_japanese" }
	}

	bitmapfont_override = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/chinese/hoi_24header_1of4"
			"gfx/fonts/chinese/hoi_24header_2of4"
			"gfx/fonts/chinese/hoi_24header_3of4"
			"gfx/fonts/chinese/hoi_24header_4of4"
		}
		languages = { "l_simp_chinese" }
	}

	bitmapfont_override = {
		name = "loadscreen_header"
		fontfiles = {
			"gfx/fonts/korean/hoi_24header_kor"
		}
		languages = { "l_korean" }
	}

	bitmapfont = {
		name = "loadscreen_tip"
		fontfiles = {
			"gfx/fonts/totu_caption_quote"
		}
		color = 0xffffffff

		textcolors = {
			P = { 246 242 234 }
			D = { 172 180 196 }
			K = { 0 0 0 }
			G = { 86 172 91 }
			R = { 222 86 70 }
			Y = { 246 242 234 }
			H = { 246 242 234 }
			T = { 255 255 255 }
		}
	}

}

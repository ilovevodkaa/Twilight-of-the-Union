# Twilight of the Union: city (victory point) names on the map, Play Bold with a dark edge.
# Written by tools/build_map_font.py; the country names replace vanilla gfx/fonts/hoi_mapfont4 directly.
bitmapfonts = {
	bitmapfont = {
		name = "totu_map_city"
